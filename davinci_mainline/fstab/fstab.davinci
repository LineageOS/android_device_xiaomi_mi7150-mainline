#

# Boot
/dev/block/by-name/boot /boot emmc defaults defaults

# Cache
/dev/block/by-name/cache /cache ext4 nodev,noatime,nosuid,discard,sync check,formattable
/dev/block/by-name/cache /cache f2fs nodev,noatime,nosuid,discard,sync check,formattable

# DSP
/dev/block/by-name/dsp /vendor/dsp ext4 ro,nosuid,nodev,barrier=1 defaults

# Firmware
/dev/block/by-name/modem /vendor/firmware_mnt vfat ro,shortname=lower,uid=1000,gid=1000,dmask=227,fmask=337,context=u:object_r:firmware_file:s0 defaults

# Metadata
/dev/block/by-name/metadata /metadata ext4 nodev,noatime,nosuid,discard,data=journal,commit=1 check,formattable,first_stage_mount,metadata_csum

# Misc
/dev/block/by-name/misc /misc emmc defaults defaults

# Persist
/dev/block/by-name/persist /mnt/vendor/persist ext4 noatime,nosuid,nodev,barrier=1 defaults

# Recovery
/dev/block/by-name/recovery /recovery emmc defaults defaults

# System
system /system ext4 noatime,ro logical,first_stage_mount

# USB
/devices/platform/soc@0/a6f8800.usb/*/usb* auto auto defaults voldmanaged=usb:auto,noemulatedsd

# Userdata
/dev/block/by-name/userdata /data ext4 nodev,noatime,nosuid,discard latemount,check,quota,formattable
/dev/block/by-name/userdata /data f2fs nodev,noatime,nosuid,discard,reserve_root=32768 latemount,check,quota,formattable

# Vendor
vendor /vendor ext4 noatime,ro logical,first_stage_mount
